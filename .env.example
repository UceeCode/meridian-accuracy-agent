# Copy to .env. Never commit .env.

# --- Option 1 (default, FREE): local model with Ollama. No key needed. ---
MERIDIAN_PROVIDER=ollama
# MERIDIAN_MODEL=qwen2.5:7b          # any Ollama model that supports tool calling (e.g. llama3.1:8b, qwen3:8b)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=16384

# --- Option 2: Anthropic API (paid) ---
# MERIDIAN_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MERIDIAN_MODEL=claude-sonnet-5-5

MERIDIAN_MAX_STEPS=40
